[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/event_ui.gd" id="1_event_ui"]

[node name="EventUI" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_event_ui")

[node name="Panel" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -220.0
offset_right = 300.0
offset_bottom = 220.0

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 20.0
offset_right = -20.0
offset_bottom = -20.0
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "事件标题"
horizontal_alignment = 1

[node name="DescLabel" type="Label" parent="Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 16
text = "事件描述"
autowrap_mode = 3

[node name="OptionA" type="Button" parent="Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "选项A"

[node name="OptionB" type="Button" parent="Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "选项B"

[connection signal="pressed" from="Panel/VBox/OptionA" to="." method="_on_option_a_pressed"]
[connection signal="pressed" from="Panel/VBox/OptionB" to="." method="_on_option_b_pressed"]
