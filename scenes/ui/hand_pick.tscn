[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/hand_pick_ui.gd" id="1_handpick"]

[node name="HandPickUI" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_handpick")

[node name="Panel" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 20.0
offset_right = -20.0
offset_bottom = -20.0
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "全知：选择手牌"
horizontal_alignment = 1

[node name="ScrollContainer" type="ScrollContainer" parent="Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="PoolContainer" type="HBoxContainer" parent="Panel/VBox/ScrollContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="ConfirmButton" type="Button" parent="Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "确认"

[connection signal="pressed" from="Panel/VBox/ConfirmButton" to="." method="_on_confirm_pressed"]
